# Server only. Include /v1 for Ollama's OpenAI-compatible API.
MODEL_URL=http://localhost:11434/v1
MODEL_NAME=qwen3:4b
# Optional smaller classifier; must be installed in the same Ollama endpoint.
CLASSIFIER_MODEL_NAME=qwen3:1.7b
MODEL_REASONING_EFFORT=provider-default
MODEL_API_KEY=
# GitHub account OR one repository: https://github.com/owner/repo
REPO_URL=https://github.com/your-github-username
# Optional, raises REST quota. Never sent to browser/model.
GITHUB_TOKEN=
APP_NAME=Candidate Atlas
# Optional public custom bio; blank/whitespace falls back to GitHub bio.
# Use a quoted value with \n\n to separate paragraphs. Never put secrets here.
CANDIDATE_BIO=
MODEL_TIMEOUT_MS=240000
CLASSIFIER_TIMEOUT_MS=20000
GITHUB_TIMEOUT_MS=12000
# Repository quick actions need at least 3 steps (discovery, inspection, answer).
MAX_AGENT_STEPS=5
# Per generation, including reasoning. Raising this also increases worst-case latency.
MAX_OUTPUT_TOKENS=4096
MAX_REPOSITORIES=50
# Overview reads only original repo READMEs, four at a time, max 6,000 excerpt chars total.
MAX_OVERVIEW_READMES=12
# Real raster images discovered in README/repo, per inspected project (1-8).
MAX_PROJECT_IMAGES=4
GITHUB_CACHE_SECONDS=300
# Optional distributed limiter for public Vercel traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
